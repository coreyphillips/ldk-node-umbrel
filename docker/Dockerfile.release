# Preserve the qualified native daemon, Iroh addon and Tor bytes from the selected release.
# Update the dashboard and its locked JavaScript dependencies.
ARG QUALIFIED_BASE=ghcr.io/coreyphillips/ldk-node-umbrel:0.1.8@sha256:aa35ba40741caac800e641cfa3a128b9d940e0a3a4edd991593e83b86a3db803
FROM ${QUALIFIED_BASE}
ENV TOR_BIN=/usr/bin/tor
COPY manager/server/ /opt/ldk/manager/server/
COPY manager/public/ /opt/ldk/manager/public/
COPY manager/package.json manager/package-lock.json /opt/ldk/manager/
RUN cd /opt/ldk/manager && npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY scripts/restore-backup.mjs /opt/ldk/scripts/restore-backup.mjs
COPY LICENSE /opt/ldk/manager/LICENSE
COPY licenses/ /opt/ldk/licenses/third-party/
LABEL org.opencontainers.image.source="https://github.com/coreyphillips/ldk-node-umbrel" \
      org.opencontainers.image.title="LDK Node for Umbrel" \
      org.opencontainers.image.version="0.1.9"
